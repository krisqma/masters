# Whisper model config
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pl
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=false

# API limits
MAX_UPLOAD_MB=25

# CORS
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Ollama — Student (RPi): gemma3:4b Q4_K_M + warm KV cache
OLLAMA_URL=http://192.168.1.173:11434/api/chat
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_READ_TIMEOUT_SECONDS=120
# Keep Student weights + system-prefix KV cache warm (interval << keep_alive)
STUDENT_KEEP_WARM_ENABLED=true
STUDENT_KEEP_WARM_INTERVAL_SECONDS=600
# Last N user/assistant messages included with each /api/chat (latency vs memory)
CHAT_HISTORY_MAX_MESSAGES=6
# Idle before frontend starts a new session (advance context + warmup)
SESSION_IDLE_ROTATE_SECONDS=600

# Context Service (external microservice on Mac)
CONTEXT_SERVICE_URL=http://127.0.0.1:8001

# TTS (edge-tts — requires outbound network to Microsoft)
TTS_VOICE=pl-PL-ZofiaNeural
TTS_RATE=+0%
TTS_MAX_CHARS=1000
