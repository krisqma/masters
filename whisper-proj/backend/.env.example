# Whisper model config
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pl
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=false

# API limits
MAX_UPLOAD_MB=25

# CORS
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Ollama - Student (RPi): gemma3:4b Q4_K_M
OLLAMA_URL=http://192.168.1.173:11434/api/chat
OLLAMA_MODEL=gemma3:4b
# -1 = keep the Student loaded forever (no inference pings needed)
OLLAMA_KEEP_ALIVE=-1
OLLAMA_READ_TIMEOUT_SECONDS=180
STUDENT_KEEP_WARM_ENABLED=true
# Watchdog interval (/api/ps only, no inference); re-warms after an Ollama restart
STUDENT_KEEP_WARM_INTERVAL_SECONDS=60
# Hard cap on history messages; the real limit is the token budget below
CHAT_HISTORY_MAX_MESSAGES=20
# Token budget: gemma3 has a 1024-token sliding window, prompt + reply must fit
# in it or the RPi recomputes the whole prompt (see stability/RAPORT.md)
STUDENT_CTX_WINDOW=1024
STUDENT_BUDGET_MARGIN=32
STUDENT_NUM_PREDICT_MAX=128
STUDENT_NUM_PREDICT_MIN=64
STUDENT_HISTORY_TRIM_RATIO=0.5
# After a trim keep at most this much history (its re-prefill costs ~7 tok/s)
STUDENT_HISTORY_KEEP_MAX_TOKENS=120
# Generation options (thesis: tab:rekomendacja_produkcyjna); identical in every
# request, a different num_ctx/num_batch/num_thread reloads the model
STUDENT_TEMPERATURE=0.2
STUDENT_TOP_P=0.9
STUDENT_REPEAT_PENALTY=1.05
STUDENT_NUM_CTX=2048
# Idle before frontend starts a new session (advance context + warmup)
SESSION_IDLE_ROTATE_SECONDS=600

# Context Service (external microservice on Mac)
CONTEXT_SERVICE_URL=http://127.0.0.1:8001

# TTS (edge-tts — requires outbound network to Microsoft)
TTS_VOICE=pl-PL-ZofiaNeural
TTS_RATE=+0%
TTS_MAX_CHARS=1000
