{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "ts": {"format": "%(asctime)s.%(msecs)03d %(levelname)s [%(name)s] %(message)s", "datefmt": "%Y-%m-%dT%H:%M:%S"}
  },
  "handlers": {
    "out": {"class": "logging.StreamHandler", "formatter": "ts", "stream": "ext://sys.stdout"}
  },
  "root": {"level": "INFO", "handlers": ["out"]},
  "loggers": {
    "uvicorn": {"level": "INFO", "handlers": ["out"], "propagate": false},
    "uvicorn.error": {"level": "INFO", "handlers": ["out"], "propagate": false},
    "uvicorn.access": {"level": "INFO", "handlers": ["out"], "propagate": false},
    "httpx": {"level": "WARNING"}
  }
}
