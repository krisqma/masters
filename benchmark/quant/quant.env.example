# Example configuration for quant benchmark. Copy to .env and fill secrets.

QUANT_OLLAMA_URL=http://mill-56-rpi.local:11434
QUANT_METRICS_URL=http://mill-56-rpi.local:9090/metrics
QUANT_MODELS_DIR=./models
QUANT_RESULTS_DIR=./results
QUANT_RUN_ID=quant_2026-06-04

# Used by prepare_models.sh for gated Hugging Face models.
HF_TOKEN=hf_...

# Used by upload_models_to_rpi.py and run_quant_benchmark.py.
QUANT_RPI_SSH=pi@mill-56-rpi.local
QUANT_REMOTE_MODELS_DIR=/home/pi/quant/models
QUANT_REMOTE_OLLAMA_HOST=127.0.0.1:11434

# Judge model via OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HAIKU_MODEL=anthropic/claude-3-5-haiku
